NODE_ENV=production
PORT=3000

# PostgreSQL. Use the Docker service name when the app runs in the same Docker network.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=autoflow
DB_PASSWORD=replace-with-a-strong-database-password
DB_DATABASE=autoflow
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# Required in production. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Enable only for the first startup of a brand-new database.
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=Admin
# Used only by the explicit initialize-production command, not automatic seeding.
PRODUCTION_ORGANIZATION_NAME=
# Account password: at least 6 characters with letters and digits, max 72 UTF-8 bytes; no case/symbol requirement.
ADMIN_BOOTSTRAP_PASSWORD=

# Required in production by the current environment validation.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password

# Zhipu GLM.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
ZHIPU_MAX_TOKENS=2048
ZHIPU_REQUEST_TIMEOUT_MS=30000
ZHIPU_TEMPERATURE=1.0
ZHIPU_THINKING_TYPE=disabled
ZHIPU_REASONING_EFFORT=high

# PipiAds.
PIPIADS_API_KEY=
PIPIADS_BASE_URL=https://www.pipispy.com/open-api/v1
PIPIADS_PAGE_SIZE=20
PIPIADS_REQUEST_TIMEOUT_MS=30000
PIPIADS_IMAGE_POLL_INTERVAL_MS=3000
PIPIADS_IMAGE_POLL_TIMEOUT_MS=45000

# Google Lens / Google search.
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
HOSTIO_API_KEY=
ENABLE_MOCK_SEARCH=false
DAILY_SEARCH_LIMIT=250
STOREFRONT_ENRICHMENT_ENABLED=true
STOREFRONT_ENRICHMENT_TIMEOUT_MS=8000

# Public origin used by providers to fetch uploaded workflow screenshots.
PUBLIC_ASSET_BASE_URL=

# Alibaba 1688 sourcing.
ALIBABA_1688_ENABLED=false
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_REFRESH_TOKEN=
ALIBABA_1688_REDIRECT_URI=https://autoflow.example.com/api/integrations/alibaba-1688/oauth/callback
ALIBABA_1688_GATEWAY_URL=https://gw.open.1688.com/openapi
ALIBABA_1688_PROTOCOL_VERSION=1
ALIBABA_1688_KEYWORD_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_KEYWORD_METHOD=product.search.keywordQuery
ALIBABA_1688_IMAGE_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_IMAGE_METHOD=product.search.imageQuery
ALIBABA_1688_DETAIL_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_DETAIL_METHOD=product.search.queryProductDetail
ALIBABA_1688_PAGE_SIZE=20
ALIBABA_1688_MAX_RESULTS=20
ALIBABA_1688_REQUEST_TIMEOUT_MS=30000
ALIBABA_1688_IMAGE_MAX_BYTES=2097152
ALIBABA_1688_IMAGE_MAX_EDGE=450

# FOP integration. Keep disabled until contracts are reconciled.
FOP_MODE=disabled
FOP_BASE_URL=
FOP_TENANT_ID=
FOP_APP_ID=
FOP_APP_SECRET=
FOP_PRODUCT_COST_OPERATION=
FOP_LOGISTICS_CHANNEL_OPERATION=
FOP_LOGISTICS_RATE_OPERATION=
FOP_CRM_HANDOFF_OPERATION=
FOP_REQUEST_TIMEOUT_MS=15000

# Workbench data stays unavailable unless kingdee mode and published endpoints are configured.
# Configure FOP_KINGDEE_* through deployment secrets; see backend/.env.fop.local.example.
# Demo mode is rejected in production. Unpublished APIs do not enable a fallback.
FOP_DATA_MODE=
# Scheme A local workbench reads; reliable source adapter must be configured separately.
WORKBENCH_READ_MODE=local
WORKBENCH_SYNC_ENABLED=false

# Disable background schedule, navigation increments and retry/authorization timers; explicit operations still obey the global FOP pause.
WORKBENCH_AUTOMATIC_CALLS_ENABLED=false

# Proposed dedicated supplier APIs; FOP endpoints/formal physical-return entity remain to be provided.
FOP_KINGDEE_SUPPLIER_CONTACTS_URL=
FOP_KINGDEE_SUPPLIER_CHAT_URL=
FOP_KINGDEE_PHYSICAL_RETURN_ENTITY=

# Timestamp synchronization: configure the real source, migrate and initialize an active
# collected batch before enabling the four flags. These placeholders make no source calls.
WORKBENCH_TIMESTAMP_ENVIRONMENT=production
WORKBENCH_TIMESTAMP_SYNC_ENABLED=false
WORKBENCH_TIMESTAMP_WORKER_HEAP_MB=8192
# All FOP HTTP callers share PostgreSQL budgets by source origin (migration 1795650000000).
# Standard public cloud hard ceilings: 20/s, 500/min, 10000/hour, 200000/day.
# Default reserve: 20%; global spacing also caps sustained traffic at 2 requests/s.
# Use the same database and canonical source origin for every process/replica.
# Lower these allocations when other applications consume the same cloud-space quota.
FOP_RATE_LIMIT_QPS=16
FOP_RATE_LIMIT_QPM=400
FOP_RATE_LIMIT_QPH=8000
FOP_RATE_LIMIT_QPD=160000
FOP_RATE_LIMIT_INTERVAL_MS=500
WORKBENCH_COLLECTED_ENABLED=false
WORKBENCH_MOCK_ENABLED=false
FOP_QUERIES_PAUSED=true
FOP_REPLICA_TENANT_ID=
FOP_REPLICA_COMPANY_ID=
FOP_REPLICA_ORG_NUMBER=
# Exact HTTPS origin, without path or trailing slash; must match the actual gateway.
# Production: KINGDEE and OPENAPI IDENTITY/ACCOUNT_ID/CLIENT_ID/CLIENT_SECRET/USERNAME must match.
# Use automatic token acquisition; do not configure either ACCESS_TOKEN.
FOP_OPENAPI_BASE_URL=
FOP_OPENAPI_ALLOWED_ORIGIN=
FOP_OPENAPI_IDENTITY=
FOP_OPENAPI_TOKEN_HEADER=accessToken
FOP_OPENAPI_CLIENT_ID=
FOP_OPENAPI_CLIENT_SECRET=
FOP_OPENAPI_ACCOUNT_ID=
FOP_OPENAPI_USERNAME=
FOP_KINGDEE_IDENTITY=
FOP_KINGDEE_TOKEN_URL=
FOP_KINGDEE_CLIENT_ID=
FOP_KINGDEE_CLIENT_SECRET=
FOP_KINGDEE_ACCOUNT_ID=
FOP_KINGDEE_USERNAME=
FOP_KINGDEE_TENANT_ID=
FOP_KINGDEE_USER_ID=
FOP_KINGDEE_ORGANIZATION_IDS=
FOP_KINGDEE_ANALYTICS_PERMISSIONS_URL=
# Directory and native operation endpoints: fill only published production APIs.
FOP_KINGDEE_DIRECTORY_URL=
FOP_KINGDEE_ACCOUNT_STATES_URL=
FOP_KINGDEE_ORGANIZATION_NUMBERS=
FOP_KINGDEE_APPROVAL_ORG_NUMBER=
FOP_KINGDEE_APPROVAL_MODE=native
FOP_KINGDEE_FULFILLMENT_AUDIT_URL=
FOP_KINGDEE_ALLOCATION_AUDIT_URL=
FOP_KINGDEE_ALLOCATION_TARGETS_URL=
FOP_KINGDEE_ORDER_DETAIL_URL=
FOP_KINGDEE_CURRENT_INVENTORY_URL=
FOP_KINGDEE_RESERVED_INVENTORY_URL=
FOP_KINGDEE_APPROVAL_CONTEXT_URL=

# 自动目录：客户档案查询所需公司全称；按目标FOP组织填写。
FOP_REPLICA_ORG_NAME=
# 每轮关系查询预算；初始历史积压分批消化，范围1—2000。
WORKBENCH_RELATION_REFRESH_LIMIT=500
