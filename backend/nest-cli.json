{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "modules/quotation/assets/**/*",
      {
        "include": "modules/workbench-export/assets/**/*",
        "outDir": "dist/src"
      }
    ]
  }
}
