# FOP test access is paused; resume only after explicit confirmation.
FOP_QUERIES_PAUSED=true
# 复制为本地忽略的 .env.fop.local；在金蝶测试环境发布后填写，不填写或虚构令牌。
FOP_DATA_MODE=kingdee
# 以下两个地址必须来自苍穹“自定义 Java WebAPI”实际登记结果，不能填写浏览器首页。
# 首期员工只读接口：EmployeeOrderController，controller=employeeOrders，mapping=/employee-orders。
# QUERY_URL 对应 /page，SUMMARY_URL 对应 /summary；只支持已付款待审核履约订单。
# 必须先部署、登记和授权，不能把旧 /fulfillment/pendingReview 路由当成已发布的新接口。
FOP_KINGDEE_QUERY_URL=
FOP_KINGDEE_SUMMARY_URL=
# 可选履约详情：仅补充已授权待支付/待审核订单的收件信息，不替代员工列表授权。
# /kapi/v2/hzkj/hzkj_ordercenter/hzkj_orders/queryOrderDetail；不完整/不一致响应明确失败。
# RMA: published read-only native endpoints; source authorization still uses employee-orders/page.
FOP_KINGDEE_RMA_URL=
FOP_KINGDEE_RMA_ORDER_LIST_URL=
FOP_KINGDEE_ORDER_DETAIL_URL=
FOP_KINGDEE_TENANT_ID=
# 兼容旧调用的可选身份/组织约束。首次连接可留空，由金蝶返回身份和当前公司组织。
FOP_KINGDEE_USER_ID=
FOP_KINGDEE_ORGANIZATION_IDS=
FOP_KINGDEE_ACCESS_TOKEN=
FOP_KINGDEE_IDENTITY=
FOP_KINGDEE_OPENAPI_SIGN=
FOP_KINGDEE_TIMEOUT_MS=10000

# 推荐自动Token模式：下面五项全部配置后，服务端自动获取/缓存/失效重取Token。
# TOKEN_URL为当前环境获取Token示例的HTTPS地址（增强型认证：/kapi/oauth2/getToken）。
# CLIENT_SECRET是AccessToken认证密钥，不能填成access_token；accountId也不能当作tenantId。
FOP_KINGDEE_TOKEN_URL=
FOP_KINGDEE_CLIENT_ID=
FOP_KINGDEE_CLIENT_SECRET=
FOP_KINGDEE_ACCOUNT_ID=
FOP_KINGDEE_USERNAME=
# 仅Token认证不需要OPENAPI_SIGN。未配置自动模式时，兼容上面的手工ACCESS_TOKEN。

# 统计接口实际登记后的两个 HTTPS 地址。统计权限与待审核权限分开核验。
FOP_KINGDEE_ANALYTICS_PERMISSIONS_URL=
## 已登记并授权的只读目录接口 /directory/page 与 /directory/accountStates。
## FOP_KINGDEE_USERNAME 作为目录读取账号；员工查询使用各自已验证绑定的用户名。
FOP_KINGDEE_DIRECTORY_URL=
FOP_KINGDEE_ACCOUNT_STATES_URL=
# 工作台使用本地组织和已核验业务员映射；不影响分析接口的现有组织口径。
# 部门经理/按部门跨人员筛选需上游 employeeFilterVersion=1 能力，否则明确提示接口待配置。
FOP_KINGDEE_LOCAL_ORGANIZATION=true
FOP_KINGDEE_ANALYTICS_QUERY_URL=
# AutoFlow独立只读备货接口：EmployeeStockController，controller=employeeStock，mapping=/employee-stock。
# 分别填写实际登记并授权的 /permissions、/orders、/inventory HTTPS 地址；空值时明确提示未配置。
FOP_KINGDEE_STOCK_PERMISSIONS_URL=
FOP_KINGDEE_STOCK_ORDERS_URL=
FOP_KINGDEE_STOCK_INVENTORY_URL=
# 仅备货清单/库存：金蝶warehouse.number仓库编码 -> HZ/SZ，按实际编码填写JSON，保留前导零和大小写。
# 此配置独立于下方FOP_KINGDEE_WAREHOUSE_MAP；待支付清单、订单分析继续使用原内码映射。
FOP_KINGDEE_STOCK_WAREHOUSE_CODE_MAP=
# 稳定的金蝶内部ID -> 页面统计代码；必须按测试环境实际基础资料填写JSON，不按名称猜测。
# 部门代码仅保留分析/旧模式使用：sales1/sales2/sales3/sales4；仓库：HZ/SZ；物流商：YT/4PX/WB/YW/JS/OTHER。
FOP_KINGDEE_DEPARTMENT_MAP=
FOP_KINGDEE_WAREHOUSE_MAP=
FOP_KINGDEE_CARRIER_MAP=
# 金蝶现有汇率表内部ID：非USD运费按确认日查原币->USD历史汇率；不写入或修改原业务。
FOP_KINGDEE_EXRATE_TABLE_ID=

# 独立 OpenAPI 只读连通性检查配置；不替代上方 Kingdee 运行时配置。
# Only used by npm run fop:test-api. This does not switch the app out of demo mode.
FOP_OPENAPI_BASE_URL=https://hyperzone.test.kdgalaxy.com
# Issued by OpenAPI > third-party application. Do not derive from the tenant name.
FOP_OPENAPI_IDENTITY=
FOP_OPENAPI_CLIENT_ID=
FOP_OPENAPI_CLIENT_SECRET=
FOP_OPENAPI_USERNAME=
# Actual data-center accountId; ierp is not assumed to be this ID.
FOP_OPENAPI_ACCOUNT_ID=
# Optional short-lived token instead of client credentials. Never commit it.
FOP_OPENAPI_ACCESS_TOKEN=
# User supplied access_token; Swagger says accessToken. Verify against gateway.
FOP_OPENAPI_TOKEN_HEADER=access_token
FOP_TEST_ORDER_NUMBER=SO261028000002
FOP_TEST_CUSTOMER_ID=
FOP_TEST_ORDER_TYPE=
# Actual document numbers, not fulfillment order numbers.
FOP_TEST_DISPATCH_NUMBER=
FOP_TEST_ALLOCATION_NUMBER=
FOP_TEST_PURCHASE_NUMBER=

# 系统管理员可显式使用后端公司查询身份；不复制员工绑定，不授予普通账号此上下文。
# 此身份必须在 FOP 内配置相应公司的完整业务查看权限；本地角色不扩大上游授权。
FOP_KINGDEE_ADMIN_SERVICE_ACCESS=false
# 工作台客户付款时间直接使用订单收款日期 hzkj_receipt_date / paidAt。
# 履约待办不需要 CUSTOMER_RECEIPTS_URL；RMA客户范围读取需组织内码到组织编码的显式映射。
# 例如 {"100000":"hyperzone"}；必须按当前环境填写。
FOP_KINGDEE_ORGANIZATION_NUMBERS=

# 新方案服务身份 API（FOP 待提供；仅配置真实已发布 HTTPS 地址，不使用旧列表路径）
FOP_REPLICA_TENANT_ID=
FOP_REPLICA_COMPANY_ID=
FOP_REPLICA_COMPANY_NUMBER=
FOP_REPLICA_ACCESS_TOKEN=
FOP_REPLICA_SNAPSHOT_BEGIN_URL=
FOP_REPLICA_SNAPSHOT_PAGE_URL=
FOP_REPLICA_BARRIER_URL=
FOP_REPLICA_CHANGES_URL=
FOP_REPLICA_AUTHORIZATION_URL=
FOP_REPLICA_RECONCILE_URL=
# 一次初始化调用最多读取的源页数；同 requestKey 再次调用续传
WORKBENCH_BOOTSTRAP_PAGE_BUDGET=10
# 独立实时专用契约；未提供时留空并明确不可用，不能指向历史清单API
FOP_KINGDEE_APPROVAL_CONTEXT_URL=
FOP_KINGDEE_OPERATION_URL=
FOP_KINGDEE_CURRENT_INVENTORY_URL=
FOP_KINGDEE_RESERVED_INVENTORY_URL=

# Disable background schedule, navigation increments and retry/authorization timers; explicit operations still obey the global FOP pause.
WORKBENCH_AUTOMATIC_CALLS_ENABLED=false

# Proposed dedicated supplier APIs; FOP endpoints/formal physical-return entity remain to be provided.
FOP_KINGDEE_SUPPLIER_CONTACTS_URL=
FOP_KINGDEE_SUPPLIER_CHAT_URL=
FOP_KINGDEE_PHYSICAL_RETURN_ENTITY=
