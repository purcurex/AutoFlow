# Copy values into .env.providers.local. Never commit the local file or real keys.

# Zhipu BigModel
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
ZHIPU_MAX_TOKENS=2048
ZHIPU_REQUEST_TIMEOUT_MS=30000
ZHIPU_TEMPERATURE=1.0
ZHIPU_THINKING_TYPE=disabled
ZHIPU_REASONING_EFFORT=high

# PipiAds Open API
PIPIADS_API_KEY=
PIPIADS_BASE_URL=https://www.pipispy.com/open-api/v1
PIPIADS_PAGE_SIZE=20
PIPIADS_REQUEST_TIMEOUT_MS=30000
PIPIADS_IMAGE_POLL_INTERVAL_MS=3000
PIPIADS_IMAGE_POLL_TIMEOUT_MS=45000

# Used only by the live provider smoke command. One PipiAds record is requested.
PIPIADS_SMOKE_KEYWORD=pet grooming brush

# Alibaba 1688 Open Platform
# The dedicated .env.alibaba1688.local file is preferred for these values.
ALIBABA_1688_ENABLED=false
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_REFRESH_TOKEN=
