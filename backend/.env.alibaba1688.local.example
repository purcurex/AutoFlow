# Alibaba 1688 Open Platform credentials.
# Copy this file to .env.alibaba1688.local and keep the local file uncommitted.
# AppSecret and tokens are backend-only secrets. Never expose them to the frontend.

# Keep disabled until the application has the required solution/API permissions
# and a valid access token for the authorized 1688 buyer account.
ALIBABA_1688_ENABLED=false
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_REFRESH_TOKEN=

# OAuth callback registered in the Alibaba Open Platform application console.
ALIBABA_1688_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/alibaba-1688/oauth/callback

# Official Open Platform gateway and the API identifiers visible in the
# application console. Keep configurable because 1688 API versions can change.
ALIBABA_1688_GATEWAY_URL=https://gw.open.1688.com/openapi
ALIBABA_1688_PROTOCOL_VERSION=1
ALIBABA_1688_KEYWORD_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_KEYWORD_METHOD=product.search.keywordQuery
ALIBABA_1688_IMAGE_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_IMAGE_METHOD=product.search.imageQuery
ALIBABA_1688_UPLOAD_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_UPLOAD_METHOD=product.image.upload
ALIBABA_1688_DETAIL_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_DETAIL_METHOD=product.search.queryProductDetail

# Provider limits and request policy.
ALIBABA_1688_PAGE_SIZE=20
ALIBABA_1688_MAX_RESULTS=20
ALIBABA_1688_REQUEST_TIMEOUT_MS=30000
ALIBABA_1688_IMAGE_MAX_BYTES=2097152
ALIBABA_1688_IMAGE_MAX_EDGE=450
SOURCING_JOB_POLL_INTERVAL_MS=500
SOURCING_JOB_LEASE_DURATION_MS=30000
