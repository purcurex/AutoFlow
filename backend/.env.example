NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=autoflow
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Zhipu GLM. Keep the API key server-side only.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
ZHIPU_MAX_TOKENS=2048
ZHIPU_REQUEST_TIMEOUT_MS=30000
ZHIPU_TEMPERATURE=1.0
# disabled for short outreach; enable only for complex analysis.
ZHIPU_THINKING_TYPE=disabled
ZHIPU_REASONING_EFFORT=high

# Primary ad discovery provider for AutoFlow workflows.
PIPIADS_API_KEY=
PIPIADS_BASE_URL=https://www.pipispy.com/open-api/v1
PIPIADS_PAGE_SIZE=20
PIPIADS_REQUEST_TIMEOUT_MS=30000
PIPIADS_IMAGE_POLL_INTERVAL_MS=3000
PIPIADS_IMAGE_POLL_TIMEOUT_MS=45000

# Alibaba 1688 product sourcing. Prefer backend/.env.alibaba1688.local for secrets.
ALIBABA_1688_ENABLED=false
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_REFRESH_TOKEN=
ALIBABA_1688_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/alibaba-1688/oauth/callback
ALIBABA_1688_GATEWAY_URL=https://gw.open.1688.com/openapi
ALIBABA_1688_PROTOCOL_VERSION=1
ALIBABA_1688_KEYWORD_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_KEYWORD_METHOD=product.search.keywordQuery
ALIBABA_1688_IMAGE_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_IMAGE_METHOD=product.search.imageQuery
ALIBABA_1688_UPLOAD_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_UPLOAD_METHOD=product.image.upload
ALIBABA_1688_DETAIL_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA_1688_DETAIL_METHOD=product.search.queryProductDetail
ALIBABA_1688_PAGE_SIZE=20
ALIBABA_1688_MAX_RESULTS=20
ALIBABA_1688_REQUEST_TIMEOUT_MS=30000
ALIBABA_1688_IMAGE_MAX_BYTES=2097152
ALIBABA_1688_IMAGE_MAX_EDGE=450
SOURCING_JOB_POLL_INTERVAL_MS=500
SOURCING_JOB_LEASE_DURATION_MS=30000

# Public HTTP(S) origin used by PipiAds to fetch uploaded workflow screenshots.
# Configure this in production, or use a public tunnel while testing locally.
PUBLIC_ASSET_BASE_URL=

# Google Lens via SerpApi. Used as the image-workflow fallback when PipiAds is unavailable.
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
HOSTIO_API_KEY=
ENABLE_MOCK_SEARCH=false
DAILY_SEARCH_LIMIT=250
STOREFRONT_ENRICHMENT_ENABLED=true
STOREFRONT_ENRICHMENT_TIMEOUT_MS=8000

# disabled | sandbox | live. Sandbox is rejected in production.
FOP_INTEGRATION_MODE=disabled
FOP_BASE_URL=
FOP_TENANT_ID=
FOP_APP_ID=
FOP_APP_SECRET=
FOP_PRODUCT_COST_OPERATION=
FOP_LOGISTICS_CHANNEL_OPERATION=
FOP_LOGISTICS_RATE_OPERATION=
FOP_CRM_HANDOFF_OPERATION=
FOP_REQUEST_TIMEOUT_MS=15000

# Disabled by default. Use only for an intentional first-admin bootstrap.
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=Admin
ADMIN_BOOTSTRAP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development-only sample data command.
DEV_SEED_PASSWORD=AutoFlowLocal123

# Optional local-only fulfillment demo: FOP_DATA_MODE=demo
# Requires NODE_ENV=development, local, or test. Omit for fail-closed live mode.
