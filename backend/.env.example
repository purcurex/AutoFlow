NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=autoflow
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

ANTHROPIC_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
HOSTIO_API_KEY=
ENABLE_MOCK_SEARCH=false
DAILY_SEARCH_LIMIT=250
STOREFRONT_ENRICHMENT_ENABLED=false
STOREFRONT_ENRICHMENT_TIMEOUT_MS=8000

# disabled | sandbox | live. Sandbox is rejected in production.
FOP_INTEGRATION_MODE=disabled
FOP_BASE_URL=
FOP_TENANT_ID=
FOP_APP_ID=
FOP_APP_SECRET=
FOP_PRODUCT_COST_OPERATION=
FOP_LOGISTICS_RATE_OPERATION=
FOP_CRM_HANDOFF_OPERATION=
FOP_REQUEST_TIMEOUT_MS=15000

# Disabled by default. Use only for an intentional first-admin bootstrap.
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development-only sample data command.
DEV_SEED_PASSWORD=AutoFlowLocal123
