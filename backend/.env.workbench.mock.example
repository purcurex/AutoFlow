# Copy the current schema and local accounts/organization into this separate local database first.
# Merge these settings into the PRIVATE .env.workbench.local; never commit credentials.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=autoflow_workbench_mock
DB_USERNAME=your_local_role
DB_PASSWORD=your_local_private_password
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
ENABLE_ADMIN_BOOTSTRAP=false
WORKBENCH_READ_MODE=local
WORKBENCH_MOCK_ENABLED=true
WORKBENCH_SYNC_ENABLED=false
FOP_DATA_MODE=demo
FOP_QUERIES_PAUSED=true
