{
  "name": "autoflow",
  "version": "1.0.0",
  "description": "Dropshipping outbound sales workflow automation workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "test": "npm run test --workspace=frontend && npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "db:migrate": "npm run migration:run --workspace=backend",
    "db:migration:show": "npm run migration:show --workspace=backend",
    "db:migration:revert": "npm run migration:revert --workspace=backend",
    "ci:local": "npm run test && npm run build",
    "start": "npm run start:prod --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
